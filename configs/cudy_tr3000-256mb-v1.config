# ==================== 目标设备配置 ====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_cudy_tr3000-256mb-v1=y

# Image formats
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Build options
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Luci
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

# FWX packages
CONFIG_PACKAGE_fwx=y
CONFIG_PACKAGE_fwxd=y
CONFIG_PACKAGE_fwx-ids=y
CONFIG_PACKAGE_fwx-threat=y
CONFIG_PACKAGE_fwx-qos=y
CONFIG_PACKAGE_fwx-urlfilter=y
CONFIG_PACKAGE_fwx-ddos=y
CONFIG_PACKAGE_fwx-vpn=y
CONFIG_PACKAGE_fwx-vlan=y
CONFIG_PACKAGE_fwx-ipsec=y
CONFIG_PACKAGE_fwx-audit=y
CONFIG_PACKAGE_fwx-reports=y
CONFIG_PACKAGE_fwx-rbac=y
CONFIG_PACKAGE_fwx-api=y
CONFIG_PACKAGE_fwx-sdwan=y
CONFIG_PACKAGE_fwx-ha=y
CONFIG_PACKAGE_libfwx_common=y
CONFIG_PACKAGE_luci-app-fwx=y
CONFIG_PACKAGE_luci-theme-fanchmwrt=y

# Network tools
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nftables=y

# ==================== 闭源无线驱动（MT7981高性能） ====================
#CONFIG_PACKAGE_kmod-mt7981-firmware=y
#CONFIG_PACKAGE_kmod-mt_wifi=y
#CONFIG_PACKAGE_mt7981-wo-firmware=y
#CONFIG_PACKAGE_kmod-mediatek_hnat=y
#CONFIG_PACKAGE_kmod-hw_nat=y
#CONFIG_PACKAGE_luci-app-mtwifi-cfg=y
#CONFIG_PACKAGE_mtkiappd=y

# ==================== USB支持（必须） ====================
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbutils=y

# ==================== 科学上网：OpenClash ====================
CONFIG_PACKAGE_luci-app-openclash=y

# ==================== 广告过滤：AdGuardHome ====================
CONFIG_PACKAGE_luci-app-adguardhome=y
CONFIG_PACKAGE_luci-i18n-adguardhome-zh-cn=y
CONFIG_PACKAGE_adguardhome=y

# ==================== 文件管理：FileBrowser ====================
CONFIG_PACKAGE_luci-app-filebrowser=y
CONFIG_PACKAGE_luci-i18n-filebrowser-zh-cn=y
CONFIG_PACKAGE_filebrowser=y

# ==================== 定时重启 ====================
CONFIG_PACKAGE_luci-app-autoreboot=y
CONFIG_PACKAGE_luci-i18n-autoreboot-zh-cn=y

# ==================== USB网络共享/4G支持 ====================
CONFIG_PACKAGE_luci-app-usbmodem=y
CONFIG_PACKAGE_luci-i18n-usbmodem-zh-cn=y
CONFIG_PACKAGE_comgt-ncm=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_kmod-mii=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_quectel-CM-5G=y

# ============================================================================
# 开源无线驱动配置 (MT7981) / Open Source WiFi Driver (MT7981)
# ============================================================================
# 使用标准 mt76 开源驱动，兼容官方 OpenWrt 和 ImmortalWrt
# Uses standard mt76 open source driver, compatible with official OpenWrt

# --- 核心无线驱动 / Core Wireless Driver ---
CONFIG_PACKAGE_kmod-mt7915e=y
# MT7915/MT7981 开源驱动主模块 / Main driver for MT7915/MT7981
# 同时驱动 2.4GHz 和 5GHz 双频 / Drives both 2.4G and 5G bands

CONFIG_PACKAGE_kmod-mt7915-firmware=y
# 开源固件 / Open source firmware
# 非闭源二进制 blob / Not proprietary binary blob

CONFIG_PACKAGE_kmod-mt76-connac=y
# CONNAC (Connectivity Academy) 支持 / CONNAC support
# MT7981 使用的连接架构 / Connection architecture used by MT7981

CONFIG_PACKAGE_kmod-mt76-core=y
# MT76 驱动核心 / MT76 driver core

# --- 标准无线子系统 / Standard Wireless Subsystem ---
CONFIG_PACKAGE_kmod-cfg80211=y
# Linux 无线配置接口 / Linux wireless configuration interface

CONFIG_PACKAGE_kmod-mac80211=y
# Linux 802.11 子系统 / Linux 802.11 subsystem
# 开源驱动的标准接口 / Standard interface for open source drivers

# --- 无线工具 / Wireless Tools ---
CONFIG_PACKAGE_iw=y
# nl80211 标准工具 / nl80211 standard tool
# 现代 Linux 无线配置 / Modern Linux wireless configuration

CONFIG_PACKAGE_iwinfo=y
# 无线信息查询 / Wireless information query
# LuCI 显示信号强度必需 / Required for signal display in LuCI

CONFIG_PACKAGE_wireless-tools=y
# 传统无线工具 / Traditional wireless tools
# 向后兼容 / Backward compatibility

# --- WPA 加密支持 / WPA Encryption Support ---
CONFIG_PACKAGE_hostapd-common=y
# hostapd 公共组件 / hostapd common components

CONFIG_PACKAGE_wpad-basic-mbedtls=y
# WPA2/WPA3 支持 (mbedTLS 版) / WPA2/WPA3 support (mbedTLS)
# 比 OpenSSL 版本更小 / Smaller than OpenSSL version
